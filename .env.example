# Copy to .env.local for development. Never commit real values.
DATABASE_URL="postgresql://user:password@localhost:5432/f1stats"
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
JOLPICA_BASE_URL="https://api.jolpi.ca/ergast/f1"
OPENF1_BASE_URL="https://api.openf1.org/v1"
# Protects /api/cron/* on Vercel (send as Authorization: Bearer <token>)
CRON_SECRET="dev-secret-change-me"
# Gates /admin write actions (form field must match). Leave empty to disable admin.
ADMIN_SECRET="dev-admin-change-me"
